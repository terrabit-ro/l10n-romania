<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template">
    <t
        t-name="PaymentScreenStatus"
        t-inherit="point_of_sale.PaymentScreenStatus"
        t-inherit-mode="extension"
    >
        <!-- Inaintea lantului t-if / t-elif din core (nu intre div si section,
             altfel t-elif-ul section-ului s-ar lega de avertismentul nostru) -->
        <xpath expr="//div[contains(@t-if, 'payment_ids.length')]" position="before">
            <div t-if="this.warningMessage == 'L5000'" class="limit-warning">
                <span>Sale to individuals only..</span>
            </div>
            <div t-if="this.warningMessage == 'L10000'" class="limit-error">
                <span>A cash sale of more than 10,000 lei cannot be made.</span>
            </div>
        </xpath>
    </t>
</templates>
