<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_l10n_ro_message_spv_tree" model="ir.ui.view">
        <field name="name">l10n.ro.message.spv.list</field>
        <field name="model">l10n.ro.message.spv</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list sample="1" create="0">
                <header>
                    <button
                        name="refresh"
                        groups="account.group_account_user"
                        string="Refresh"
                        type="object"
                        icon="fa-refresh"
                        display="always"
                    />
                    <button
                        name="download_from_spv"
                        string="Download"
                        type="object"
                        groups="account.group_account_user"
                    />
                    <button
                        name="get_invoice_from_move"
                        groups="account.group_account_user"
                        string="Get Invoice"
                        type="object"
                    />
                    <button
                        name="create_invoice"
                        groups="account.group_account_user"
                        string="Create Invoice"
                        type="object"
                    />
                    <button name="show_invoice" string="Show Invoice" type="object" />
                    <button
                        name="action_accept"
                        groups="account.group_account_user"
                        string="Accept"
                        type="object"
                    />
                    <button
                        name="action_reject"
                        groups="account.group_account_user"
                        string="Reject"
                        type="object"
                    />
                </header>

                <field name="name" optional="hide" />
                <field name="ref" />
                <field name="message_type" optional="show" />
                <field name="partner_name" />
                <field name="cif" optional="show" />
                <field name="partner_id" optional="hide" />
                <field name="invoice_date" />
                <field name="invoice_date_due" optional="show" />
                <field name="date" optional="show" />
                <field name="request_id" optional="hide" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="currency_id" optional="show" />
                <field name="amount_untaxed" sum="1" optional="show" />
                <field name="amount_tax" sum="1" optional="show" />
                <field
                    name="amount"
                    sum="1"
                    decoration-danger="invoice_amount and amount != invoice_amount"
                />
                <field name="invoice_amount" column_invisible="1" />
                <field name="attachment_id" column_invisible="1" />
                <field name="review_required" column_invisible="1" />

                <field name="invoice_id" optional="show" />
                <field
                    name="state"
                    widget="badge"
                    decoration-success="state == 'done'"
                    decoration-info="state == 'downloaded'"
                    decoration-primary="state == 'invoice'"
                    decoration-danger="state == 'error'"
                />
                <field
                    name="review_state"
                    widget="badge"
                    optional="show"
                    decoration-warning="review_state == 'pending'"
                    decoration-success="review_state == 'accepted'"
                    decoration-danger="review_state == 'rejected'"
                />
                <button
                    name="action_download_pdf"
                    type="object"
                    icon="fa-file-pdf-o"
                    title="Download the invoice PDF"
                    invisible="not attachment_id"
                />
                <button
                    name="action_download_xml"
                    type="object"
                    icon="fa-file-code-o"
                    title="Download the invoice XML"
                    invisible="not attachment_id"
                />
            </list>
        </field>
    </record>

    <record id="view_l10n_ro_message_spv_form" model="ir.ui.view">
        <field name="name">l10n.ro.message.spv.form</field>
        <field name="model">l10n.ro.message.spv</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button
                        name="download_from_spv"
                        string="Download"
                        type="object"
                        groups="account.group_account_user"
                    />
                    <button
                        name="get_invoice_from_move"
                        groups="account.group_account_user"
                        string="Get Invoice"
                        type="object"
                    />
                    <button
                        name="create_invoice"
                        groups="account.group_account_user"
                        string="Create Invoice"
                        type="object"
                        invisible="message_type not in ('in_invoice','in_receipt')"
                    />
                    <button
                        name="action_download_attachment"
                        string="ZIP"
                        type="object"
                        icon="fa-file-archive-o"
                        invisible="not attachment_id"
                        title="Download the signed ANAF ZIP"
                    />
                    <button
                        name="action_download_xml"
                        string="XML"
                        type="object"
                        icon="fa-file-code-o"
                        invisible="not attachment_id"
                        title="Download the invoice XML"
                    />
                    <button
                        name="action_download_anaf_pdf"
                        string="PDF ANAF"
                        type="object"
                        icon="fa-file-pdf-o"
                        invisible="not attachment_id"
                        title="Download the PDF rendered by ANAF"
                    />
                    <button
                        name="action_download_embedded_pdf"
                        string="PDF"
                        type="object"
                        icon="fa-paperclip"
                        invisible="not attachment_id"
                        title="Download the PDF embedded in the invoice XML"
                    />
                    <button
                        name="action_accept"
                        string="Accept"
                        type="object"
                        class="btn-primary"
                        groups="account.group_account_user"
                        invisible="not review_required or message_type not in ('in_invoice', 'in_receipt') or review_state == 'accepted'"
                    />
                    <button
                        name="action_reject"
                        string="Reject"
                        type="object"
                        groups="account.group_account_user"
                        invisible="not review_required or message_type not in ('in_invoice', 'in_receipt') or review_state == 'rejected'"
                    />
                    <button
                        name="action_review_reset"
                        string="Back to Review"
                        type="object"
                        groups="account.group_account_user"
                        invisible="not review_required or review_state in (False, 'pending')"
                    />
                </header>
                <sheet>
                    <group>
                        <group string="Message">
                            <field name="name" />
                            <field name="cif" />
                            <field name="message_type" />
                            <field name="date" />
                            <field name="details" />
                            <field name="request_id" />
                        </group>
                        <group string="Reference">
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="partner_name" />
                            <field name="partner_id" />
                            <field name="ref" />
                            <field name="invoice_date" />
                            <field name="invoice_date_due" />
                            <field name="invoice_id" />
                            <field name="currency_id" />
                            <field name="amount_untaxed" />
                            <field name="amount_tax" />
                            <field
                                name="amount"
                                decoration-danger="invoice_amount and amount != invoice_amount"
                            />
                            <field name="invoice_amount" invisible="1" />
                            <field
                                name="state"
                                widget="badge"
                                decoration-success="state == 'done'"
                                decoration-info="state == 'downloaded'"
                                decoration-primary="state == 'invoice'"
                                decoration-danger="state == 'error'"
                            />
                            <field name="review_required" invisible="1" />
                            <field name="attachment_id" invisible="1" />
                            <field
                                name="review_state"
                                widget="badge"
                                invisible="not review_state"
                                decoration-warning="review_state == 'pending'"
                                decoration-success="review_state == 'accepted'"
                                decoration-danger="review_state == 'rejected'"
                            />
                            <field
                                name="review_reason"
                                invisible="review_state != 'rejected'"
                            />
                        </group>

                        <group
                            string="Errors and Info"
                            invisible="not error and not message"
                        >
                            <field name="error" invisible="not error" />
                            <field name="message" invisible="not message" />
                        </group>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_l10n_ro_message_spv_search" model="ir.ui.view">
        <field name="name">l10n.ro.message.spv.search</field>
        <field name="model">l10n.ro.message.spv</field>
        <field name="type">search</field>
        <field name="arch" type="xml">
            <search>
                <field name="ref" />
                <field name="partner_name" />
                <field name="cif" />
                <field name="name" />
                <field name="message_type" />
                <field name="date" />
                <field name="invoice_date" />
                <field name="partner_id" />
                <field name="request_id" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="invoice_id" />
                <field name="state" />
                <group>
                    <filter
                        string="Draft"
                        name="draft"
                        domain="[('state', '=', 'draft')]"
                    />
                    <filter
                        string="Done"
                        name="done"
                        domain="[('state', '=', 'done')]"
                    />
                    <separator />
                    <filter
                        string="In Invoices"
                        name="invoices"
                        domain="[('message_type', '=', 'in_invoice')]"
                    />
                    <filter
                        string="Out Invoices"
                        name="out_invoices"
                        domain="[('message_type', '=', 'out_invoice')]"
                    />
                    <filter
                        string="Errors"
                        name="errors"
                        domain="[('message_type', '=', 'error')]"
                    />
                    <separator />
                    <filter
                        string="To Review"
                        name="review_pending"
                        domain="[('review_state', '=', 'pending')]"
                    />
                    <filter
                        string="Accepted"
                        name="review_accepted"
                        domain="[('review_state', '=', 'accepted')]"
                    />
                    <filter
                        string="Rejected"
                        name="review_rejected"
                        domain="[('review_state', '=', 'rejected')]"
                    />
                    <separator />
                    <filter
                        string="Not Accounted"
                        name="not_accounted"
                        domain="[('invoice_id', '=', False)]"
                    />
                    <filter
                        string="Accounted"
                        name="accounted"
                        domain="[('state', '=', 'done')]"
                    />
                    <separator />
                    <filter string="Date" name="date" date="date" />
                    <filter
                        string="Invoice Date"
                        name="invoice_date"
                        date="invoice_date"
                    />
                    <filter
                        string="Due Date"
                        name="invoice_date_due"
                        date="invoice_date_due"
                    />
                </group>
                <group>
                    <filter
                        name="group_state"
                        string="State"
                        context="{'group_by': 'state'}"
                    />
                    <filter
                        name="group_message_type"
                        string="Type"
                        context="{'group_by': 'message_type'}"
                    />
                    <filter
                        name="group_partner_name"
                        string="Partner"
                        context="{'group_by': 'partner_name'}"
                    />
                    <filter
                        name="group_review_state"
                        string="Review"
                        context="{'group_by': 'review_state'}"
                    />
                    <filter
                        name="group_currency_id"
                        string="Currency"
                        context="{'group_by': 'currency_id'}"
                    />
                    <filter
                        name="group_company_id"
                        string="Company"
                        context="{'group_by': 'company_id'}"
                        groups="base.group_multi_company"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_l10n_ro_message_spv" model="ir.actions.act_window">
        <field name="name">Messages SPV</field>
        <field name="res_model">l10n.ro.message.spv</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_l10n_ro_spv"
        name="SPV"
        parent="account.menu_finance_entries"
        action="action_l10n_ro_message_spv"
        groups="l10n_ro_config.group_ro_menus"
    />
    <menuitem
        id="menu_l10n_ro_message_spv"
        name="Messages SPV"
        parent="menu_l10n_ro_spv"
        action="action_l10n_ro_message_spv"
        groups="l10n_ro_config.group_ro_menus"
    />
</odoo>
