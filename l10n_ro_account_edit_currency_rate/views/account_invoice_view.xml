<?xml version="1.0" ?>
<odoo>
    <record id="l10n_ro_view_move_form_edit_currency" model="ir.ui.view">
        <field name="name">account.move.form.edit.currency</field>
        <field name="model">account.move</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <field name="invoice_currency_rate" position="attributes">
                <attribute
                    name="readonly"
                >country_code != 'RO' and state != 'draft'</attribute>
            </field>
            <!-- In 20.0 the rate is edited through the exchange rate widget,
                 the field itself is invisible. -->
            <xpath
                expr="//widget[@name='account_currency_exchange_rate']"
                position="attributes"
            >
                <attribute
                    name="readonly"
                >country_code != 'RO' and state != 'draft'</attribute>
            </xpath>
        </field>
    </record>
</odoo>
